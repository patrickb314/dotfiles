#!/bin/bash
# Provision the MCP servers Claude Code should offer in every project.
#
# Run by script/setup for the host account, then piped into `sv shell` so the
# same commands run again inside the SandVault guest account. Each account has
# to do this for itself: `uv tool install` writes into the invoking user's home,
# and Claude Code keeps its server list in ~/.claude.json, a file it writes
# itself and fills with session state, so there is nothing here to copy from one
# account to the other. The Zotero library and its semantic search index are
# the exceptions: the main account puts both in the shared workspace, where the
# sandbox account reads the one and takes a copy of the other.
#
# Credentials are deliberately absent. Claude Code runs an MCP server as a child
# process, so each one reads its key out of the environment `credlogin` set up
# in the shell that started Claude Code; see the `firecrawl` and `zotero`
# services in credlogin.sh.

set -eo pipefail

# The Brewfile lists these two as well, which is what keeps `brew bundle
# cleanup` from uninstalling them; installing them here is what gets them into
# the second account, since a uv tool lands in the invoking user's home.
# `firecrawl-mcp` needs neither, being an npm package in the shared prefix.
uv tool install arxiv-mcp-server
uv tool install "zotero-mcp-server[all]"

# In the sandbox, `claude` on PATH is sandvault's own wrapper, which execs an
# interactive session rather than passing a subcommand through untouched.
CLAUDE="${HOMEBREW_PREFIX}/bin/claude"
[[ -x "${CLAUDE}" ]] || CLAUDE="$(command -v claude)"

# Removing first is what makes this rerunnable: `claude mcp add` refuses a name
# that already exists, and an edit to a command below should take effect rather
# than be skipped as already present.
mcp_add() {
  local name="$1"
  shift
  "${CLAUDE}" mcp remove "${name}" --scope user &>/dev/null || true
  "${CLAUDE}" mcp add "${name}" --scope user -- "$@"
}

mcp_add arxiv "${HOME}/.local/bin/arxiv-mcp-server"
mcp_add firecrawl firecrawl-mcp

# zotero-mcp registers itself instead of going through `mcp_add`, because the
# server is more than a command line: `zotero-mcp setup` finds its own
# executable and writes the mcpServers entry from the semantic-search settings
# in ~/.config/zotero-mcp/config.json, so the entry and the settings cannot
# drift apart. The `[all]` extra above is what makes the full server available
# — PDF extraction (pymupdf), semantic search (chromadb, sentence-transformers),
# and Scite citation data — and the extra has to be spelled the same way in the
# Brewfile, since `brew bundle` compares the whole requirement string and would
# otherwise reinstall the bare package over this one.
#
# Semantic search embedding backend. "ollama" embeds with the model named
# below, which `ollama-models.txt` keeps pulled and the main account serves on
# localhost for both accounts. "default" is the bundled all-MiniLM-L6-v2, which
# needs nothing started at all. Changing this line in either direction wants
# `zotero-mcp update-db --force-rebuild` in each account, since a model of a
# different vector width cannot read the embeddings already in the database.
EMBEDDING_BACKEND="ollama"
EMBEDDING_MODEL="qwen3-embedding:8b" # read only when the backend is ollama
EMBEDDING_BASE_URL="http://localhost:11434"

ZOTERO_CONFIG="${HOME}/.config/zotero-mcp/config.json"
mkdir -p "${ZOTERO_CONFIG%/*}"
# The directory holds the search index alongside the config, and `zotero-mcp`
# itself warns when the other account on this machine can read either.
chmod 700 "${ZOTERO_CONFIG%/*}"
[[ -f "${ZOTERO_CONFIG}" ]] || echo '{}' >"${ZOTERO_CONFIG}"

# The library itself lives in the shared workspace rather than in `~/Zotero`,
# so that an agent in the sandbox can open the papers attached to an item. The
# sandbox profile denies `/Users/${USER}` outright, which no amount of pointing
# `zotero-mcp` at the right database can work around; under the shared
# workspace the PDFs are ordinary files both accounts can read. `~/Zotero` is
# left behind as a symlink, which keeps Zotero desktop and its plugins on the
# path they already recorded and saves editing a `prefs.js` that Zotero
# rewrites for itself on every exit.
#
# Moving is a rename, both paths being on the same APFS volume, but Zotero
# holds `zotero.sqlite` open while it runs, so a running copy is left where it
# is and a later run picks the move up.
SHARED="${SHARED_WORKSPACE:-/Users/Shared/sv-${USER}}"
ZOTERO_DATA_DIR="${SHARED}/Zotero"

if [[ -z "${SANDVAULT}" ]] && command -v sv &>/dev/null &&
  [[ -d "${HOME}/Zotero" && ! -L "${HOME}/Zotero" ]]; then
  if pgrep -f "Zotero.app/Contents/MacOS/zotero" &>/dev/null; then
    echo "Quit Zotero and rerun to move its library to ${ZOTERO_DATA_DIR}" >&2
  elif [[ -e "${ZOTERO_DATA_DIR}" ]]; then
    echo "${ZOTERO_DATA_DIR} exists; leaving ${HOME}/Zotero where it is" >&2
  else
    mkdir -p "${SHARED}"
    mv "${HOME}/Zotero" "${ZOTERO_DATA_DIR}"
    ln -s "${ZOTERO_DATA_DIR}" "${HOME}/Zotero"
  fi
fi

# Left to itself `zotero-mcp` finds the database by reading the data directory
# out of Zotero's own profile, which only the main account can do — the sandbox
# cannot see `~/Library`. Naming the moved database outright is what lets the
# server in either account open the same library, and with it the same
# attachments, since `storage/` is resolved beside the database. The name is
# written only once the file is really there, so that a library still waiting
# on a Zotero quit is found the old way rather than not at all.
ZOTERO_DB="${ZOTERO_DATA_DIR}/zotero.sqlite"
[[ -f "${ZOTERO_DB}" ]] || ZOTERO_DB=""

# The index is still built once and copied rather than built in each account:
# embedding every passage in the library a second time would cost minutes of
# GPU work for a database identical to the first. The main account leaves its
# index in the shared workspace, and the sandbox copies that in along with the
# sync bookkeeping in `config.json`, so the two accounts search the same
# passages at the same library version.
ZOTERO_INDEX="${SHARED}/zotero-index"

# `cp -c` clones on APFS, so the staged copy and the sandbox's copy of a
# multi-gigabyte index cost no disk until the next reindex rewrites the
# original; `-p` keeps the timestamps the `-nt` tests below compare.
clone_index() {
  local src="$1" dest="$2" name
  mkdir -p "${dest}"
  for name in chroma_db fulltext_cache; do
    [[ -d "${src}/${name}" ]] || continue
    rm -rf "${dest:?}/${name}"
    cp -Rpc "${src}/${name}" "${dest}/${name}"
  done
}

# Compared on `chroma.sqlite3` rather than the directory holding it, because
# the database is rewritten in place and leaves that directory's own timestamp
# untouched. The staged `config.json` is written last, so its presence is what
# says the staged index is complete.
if [[ -n "${SANDVAULT}" && -f "${ZOTERO_INDEX}/config.json" ]] &&
  [[ "${ZOTERO_INDEX}/chroma_db/chroma.sqlite3" -nt "${ZOTERO_CONFIG%/*}/chroma_db/chroma.sqlite3" ]]; then
  clone_index "${ZOTERO_INDEX}" "${ZOTERO_CONFIG%/*}"
  cp -p "${ZOTERO_INDEX}/config.json" "${ZOTERO_CONFIG}"
fi

AUTO_UPDATE=true
[[ -z "${SANDVAULT}" ]] || AUTO_UPDATE=false

# `zotero-mcp setup --semantic-config-only` asks these as interactive questions,
# which a piped shell cannot answer, so write the answers instead. The daily
# auto-update keeps the index current without anyone remembering to rebuild it;
# the server runs it on a background thread at startup, so it costs a session
# nothing. Merging rather than replacing preserves the `last_update` stamp the
# server keeps in the same block. Only the main account updates, so a newly
# added paper is embedded once rather than in both accounts; the sandbox takes
# the finished index on its next setup run.
#
# Chunking is off upstream, which indexes each item as a single vector truncated
# at the embedding model's input limit — enough for a title and abstract, but it
# throws away nearly all of an attached paper. Indexing overlapping passages
# instead makes the whole paper searchable and lets a hit quote the passage it
# came from. Forty passages covers a long paper, and embedding one costs about
# thirty milliseconds against the local model, so the depth is close to free.
jq --arg backend "${EMBEDDING_BACKEND}" \
  --arg model "${EMBEDDING_MODEL}" \
  --arg base_url "${EMBEDDING_BASE_URL}" \
  --arg db_path "${ZOTERO_DB}" \
  --argjson auto_update "${AUTO_UPDATE}" '
  (if $db_path == "" then . else .zotero_db_path = $db_path end)
  | .semantic_search += {
    embedding_model: $backend,
    embedding_config: (
      if $backend == "default" then {}
      else {model_name: $model, base_url: $base_url}
      end
    ),
    update_config: (
      (.semantic_search.update_config // {})
        + {auto_update: $auto_update, update_frequency: "daily"}
    ),
    chunking: {enabled: true, chunk_size: 1500, overlap: 200,
               max_chunks_per_item: 40}
  }' "${ZOTERO_CONFIG}" >"${ZOTERO_CONFIG}.new"
mv "${ZOTERO_CONFIG}.new" "${ZOTERO_CONFIG}"
chmod 600 "${ZOTERO_CONFIG}"

# Hand the finished index to the sandbox. `local_api` is dropped on the way:
# it holds the key Zotero granted this account for writes, and reading needs no
# key at all.
if [[ -z "${SANDVAULT}" ]] && command -v sv &>/dev/null &&
  [[ "${ZOTERO_CONFIG%/*}/chroma_db/chroma.sqlite3" -nt "${ZOTERO_INDEX}/chroma_db/chroma.sqlite3" ]]; then
  clone_index "${ZOTERO_CONFIG%/*}" "${ZOTERO_INDEX}"
  jq 'del(.local_api)' "${ZOTERO_CONFIG}" >"${ZOTERO_INDEX}/config.json"
fi

# Left in the local-API mode upstream recommends: Zotero desktop serves
# localhost:23119, which both accounts can reach, and that mode reads
# attachments straight off disk rather than pulling them back down over the web
# API. It also keeps `setup` from writing ZOTERO_API_KEY into ~/.claude.json —
# credlogin's keys stay in the environment, unread until someone drops the
# ZOTERO_LOCAL entry from that file to run against the web API instead.
"${HOME}/.local/bin/zotero-mcp" setup \
  --skip-semantic-search --config-path "${HOME}/.claude.json"

# Language servers, offered to Claude Code the way an editor gets them: an LSP
# plugin whose `.lsp.json` names the same Homebrew binaries the Zed settings
# point at, so the editor and the agent drive one set of servers rather than
# each downloading its own. `claude/settings.json` declares the marketplace as
# `~/.claude/marketplace`, the copy `script/setup` installs, which is a path
# both accounts have. Only the install is per-account state, and skipping it
# when it is already done leaves the settings file untouched on a rerun.
if ! "${CLAUDE}" plugin list 2>/dev/null | grep -q "lsp@dotfiles"; then
  "${CLAUDE}" plugin install lsp@dotfiles --scope user --yes
fi
