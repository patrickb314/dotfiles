// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "vim_mode": true,
  "base_keymap": "Zed",
  "ui_font_family": ".SystemUIFont",
  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Frappé"
  },
  "restore_on_startup": "empty_tab",
  "session": {
    "trust_all_worktrees": true,
    "restore_unsaved_buffers": false
  },
  "edit_predictions": {
    "ollama": {
      "api_url": "http://localhost:11434",
      "model": "qwen3-coder:30b",
      "prompt_format": "qwen",
      "max_output_tokens": 512
    },
    "provider": "ollama",
    "disabled_globs": [],
  },
  "language_models": {
    "anthropic": {
      "provider": "anthropic_subscription"
    },
    "ollama": {
      "api_url": "http://localhost:11434",
      "auto_discover": false,
      "available_models": [
        {
          "name": "qwen3.6:27b",
          "display_name": "Qwen3.6 27B",
          "max_tokens": 32768,
          "supports_tools": true,
          "supports_thinking": true,
          "supports_images": true
        },
        {
          "name": "qwen3-coder:30b",
          "display_name": "Qwen3 Coder 30B",
          "max_tokens": 32768,
          "supports_tools": true,
          "supports_thinking": false,
          "supports_images": false
        }
      ]
    }
  },
  "use_system_window_tabs": true,
  "title_bar": {
    "show_branch_status_icon": true,
    "show_menus": true,
  },
  "autosave": "on_focus_change",
  "buffer_font_family": "SF Mono",
  "buffer_font_weight": 500,
  "buffer_font_size": 12,
  "current_line_highlight": "gutter",
  "cursor_blink": false,
  "auto_install_extensions": {
    "catppuccin-icons": true,
    "html": true,
    "latex": true,
    "macos-classic": true,
    "make": true,
    "neocmake": true,
    "ruby": true,
    "toml": true,
  },
  "lsp": {
    "bash-language-server": {
      "binary": {
        "path": "/opt/homebrew/bin/bash-language-server",
        "arguments": ["start"],
      },
    },
    "clangd": {
      "binary": {
        "path": "/opt/homebrew/opt/llvm/bin/clangd",
      },
    },
    "json-language-server": {
      "binary": {
        "path": "/opt/homebrew/bin/vscode-json-language-server",
        "arguments": ["--stdio"],
      },
    },
    "pylsp": {
      "binary": {
        "path": "/opt/homebrew/bin/pylsp",
      },
    },
    "texlab": {
      "binary": {
        "path": "/opt/homebrew/bin/texlab",
      },
    },
    "yaml-language-server": {
      "binary": {
        "path": "/opt/homebrew/bin/yaml-language-server",
        "arguments": ["--stdio"],
      },
    },
  },
  "languages": {
    "Shell Script": {
      "tab_size": 2,
    },
    "Python": {
      "language_servers": ["pylsp"],
    },
    "Ruby": {
      "language_servers": ["ruby-lsp", "rubocop"],
    },
  },
  "preferred_line_length": 118,
  "show_whitespaces": "boundary",
  "tab_bar": {
    "show_nav_history_buttons": false,
  },
  "tabs": {
    "close_position": "left",
    "file_icons": true,
    "git_status": true,
  },
  "theme": {
    "mode": "system",
    "light": "macOS Classic Light",
    "dark": "macOS Classic Dark",
  },
  "terminal": {
    "dock": "right",
  },
  "ui_font_size": 15.0,
  "wrap_guides": [80, 118],
}
